<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').StartsWith('win-'))">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ShoneHtml/ShoneHtml.csproj" />
  </ItemGroup>

  <Target Name="GetWorkerDeploymentFiles" DependsOnTargets="Build;ComputeFilesToPublish" Returns="@(_WorkerDeploymentFile)">
    <ItemGroup>
      <_WorkerDeploymentFile Include="@(ResolvedFileToPublish->'%(FullPath)')" />
    </ItemGroup>
  </Target>
</Project>
